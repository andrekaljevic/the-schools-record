---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import PageHero from '../../components/PageHero.astro';
import Notice from '../../components/Notice.astro';
import FormShell from '../../components/FormShell.astro';
import { titled } from '../../lib/meta';

const policy = [
  ['Identify the exact record.', 'Give the school, dataset, year and field where possible.'],
  ['State the definition.', 'Explain whether the evidence concerns entries, candidates, offers, acceptances or destinations.'],
  ['Provide source detail.', 'Describe the originating publication and where it can be checked.'],
  ['Review without silent mutation.', 'The existing record remains unchanged while the issue is assessed.'],
  ['Version any approved revision.', 'A future commissioned data update receives a new snapshot, parity accounting and changelog entry.'],
];
const crumbs = [{ label: 'Corrections', href: '/corrections/' }, { label: 'Report a correction', href: null }];
---
<Base meta={{ title: titled('Report a correction'), description: 'Report a specific, evidenced correction. The frozen edition is not changed until a versioned editorial review.' }} crumbs={crumbs} bodyClass="page-form">
  <main id="main-content">
    <PageHero eyebrow="Editorial accountability" title="Report a correction" intro="Specific, source-backed reports are reviewed against the record's definitions and evidence rules." note="Submitting a report does not alter this data-frozen edition. Statistical changes require a separate, approved and versioned editorial process." />
    <section class="section shell correction-layout">
      <article class="prose">
        <h2>Correction policy</h2>
        <ol>{policy.map(([title, body]) => <li><strong>{title}</strong> {body}</li>)}</ol>
        <Notice title="No automatic correction"><p>An anomaly or conflicting website is not enough to overwrite a production value. Conflicts can be preserved explicitly.</p></Notice>
        <p><a class="text-link" href="/corrections/">Read the corrections already recorded <Icon name="arrow-right" /></a></p>
      </article>
      <div>
        <div class="form-intro">
          <p class="eyebrow">Structured report</p>
          <h2>Tell us exactly where to look</h2>
          <p>Only the details needed to check a figure are requested. A report creates an internal review item; it does not change any figure, take any payment or send automated email.</p>
        </div>
        <FormShell kind="correction-report" action="/api/correction" submitLabel="Submit correction report" id="correction-form">
          <div class="field"><label for="cr-name">Name <span aria-hidden="true">*</span></label><input id="cr-name" name="name" type="text" required maxlength="120" autocomplete="name" /></div>
          <div class="field"><label for="cr-email">Email <span aria-hidden="true">*</span></label><input id="cr-email" name="email" type="email" required maxlength="254" autocomplete="email" /></div>
          <div class="field"><label for="cr-school">School <span aria-hidden="true">*</span></label><input id="cr-school" name="school" type="text" required maxlength="120" /></div>
          <div class="field"><label for="cr-period">Year or period</label><input id="cr-period" name="period" type="text" maxlength="80" /></div>
          <div class="field span-2"><label for="cr-dataset">Dataset or page</label><input id="cr-dataset" name="dataset" type="text" maxlength="160" /><span class="field-help">The ledger identifier shown under each table, or the page address.</span></div>
          <div class="field span-2"><label for="cr-issue">What appears to be wrong? <span aria-hidden="true">*</span></label><textarea id="cr-issue" name="issue" rows="6" required maxlength="4000"></textarea></div>
          <div class="field span-2"><label for="cr-evidence">Supporting evidence reference</label><textarea id="cr-evidence" name="evidenceReference" rows="3" maxlength="1000" placeholder="Describe the publication and where it can be found. This is stored privately."></textarea></div>
          <label class="form-consent span-2"><input type="checkbox" id="cr-consent" name="consent" required /><span>I have read the <a href="/privacy/">privacy notice</a> and agree that these details may be stored to review this report. <span aria-hidden="true">*</span></span></label>
        </FormShell>
      </div>
    </section>
  </main>
</Base>
