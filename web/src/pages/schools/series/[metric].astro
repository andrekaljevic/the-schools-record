---
import SchoolIndex from '../../../components/SchoolIndex.astro';
import { indexPanels } from '../../../lib/data';
export function getStaticPaths() {
  return Object.keys(indexPanels()).filter((id) => id !== 'a_level_astar').map((metric) => ({ params: { metric } }));
}
const { metric } = Astro.params;
---
<SchoolIndex metricId={metric} />
