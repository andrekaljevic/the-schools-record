---
import SchoolIndex from '../../../components/SchoolIndex.astro';
import { indexPanels } from '../../../lib/data';
export function getStaticPaths() {
  return Object.values(indexPanels())
    .filter((metric) => metric.id !== 'a_level_astar')
    .map((metric) => ({ params: { metric: metric.slug }, props: { metricId: metric.id } }));
}
const { metricId } = Astro.props as { metricId: string };
---
<SchoolIndex metricId={metricId} />
