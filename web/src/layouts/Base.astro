---
import '../styles/global.css';
import newsreaderUrl from '@fontsource-variable/newsreader/files/newsreader-latin-wght-normal.woff2?url';
import interUrl from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import type { Crumb } from '../components/Breadcrumbs.astro';
import JsonLd from '../components/JsonLd.astro';
import { breadcrumbJsonLd, datasetJsonLd, websiteJsonLd, type PageMeta } from '../lib/meta';

interface Props {
  meta: PageMeta;
  crumbs?: Crumb[];
  bodyClass?: string;
  /** Handle legacy `/?p=/route` links from the previous deployment. */
  legacyRedirect?: boolean;
}
const { meta, crumbs = [], bodyClass = '', legacyRedirect = false } = Astro.props;
// Absolute addresses (canonical, Open Graph, structured data) are emitted only when the
// deployment supplies its origin; a preview build must never advertise a placeholder host.
const originKnown = Boolean(process.env.SITE_URL);
const origin = originKnown && Astro.site ? Astro.site.origin : '';
const canonical = originKnown && !meta.noindex ? `${origin}${Astro.url.pathname}` : null;
const isHome = Astro.url.pathname === '/';
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{meta.title}</title>
    <link rel="preload" href={newsreaderUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={interUrl} as="font" type="font/woff2" crossorigin />
    <meta name="description" content={meta.description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {meta.noindex && <meta name="robots" content="noindex,follow" />}
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#f3f0e8" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="The Schools Record" />
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {originKnown && <meta property="og:image" content={`${origin}/social-card.png`} />}
    {originKnown && <meta property="og:image:width" content="1200" />}
    {originKnown && <meta property="og:image:height" content="630" />}
    {originKnown && <meta property="og:image:alt" content="The Schools Record: independent school results, year by year" />}
    <meta property="og:locale" content="en_GB" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={meta.title} />
    <meta name="twitter:description" content={meta.description} />
    {originKnown && <meta name="twitter:image" content={`${origin}/social-card.png`} />}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {isHome && originKnown && <JsonLd data={websiteJsonLd(origin)} />}
    {meta.dataset && <JsonLd data={datasetJsonLd()} />}
    {crumbs.length > 0 && originKnown && <JsonLd data={breadcrumbJsonLd(origin, crumbs)} />}
    {legacyRedirect && (
      <script>
        import '../islands/legacy-redirect.ts';
      </script>
    )}
  </head>
  <body class={bodyClass}>
    <Header />
    {crumbs.length > 0 && <div class="shell"><Breadcrumbs items={crumbs} /></div>}
    <slot />
    <Footer />
  </body>
</html>
