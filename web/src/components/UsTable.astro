---
import Icon from './Icon.astro';
import StatusPill from './StatusPill.astro';
import type { UsRow } from '../lib/types';
import { recordPath } from '../lib/routes';
interface Props { rows: UsRow[]; caption: string }
const { rows, caption } = Astro.props;
const dash = (value: unknown) => (value === null || value === undefined || value === '' ? '—' : String(value));
---
<div class="table-scroll" tabindex="0" aria-label={`Scrollable table: ${caption}`}>
  <table class="data-table corpus-table">
    <caption>{caption}</caption>
    <thead><tr><th scope="col">Period</th><th scope="col">Institution</th><th scope="col">Outcome type</th><th scope="col">Count</th><th scope="col">Cohort denominator</th><th scope="col">Rate</th><th scope="col">Region</th><th scope="col">Evidence</th><th scope="col">Record</th></tr></thead>
    <tbody>
      {rows.map((row) => (
        <tr data-period={row.period} data-type={row.metricType} data-region={row.region ?? ''} data-rows={row.aggregate ? 'aggregate' : 'institution'} data-year={row.year ?? ''}>
          <th scope="row">{row.period}</th>
          <td class="text">{row.institution} {row.aggregate && <StatusPill text="Aggregate" />}{row.conflictGroup && <StatusPill text={row.canonical ? 'Version kept' : 'Alternative version'} tone="brass" />}</td>
          <td class="text">{row.metricLabel}</td>
          <td>{row.count}</td>
          {row.denominator === '—' ? <td class="blank-value">—</td> : <td>{row.denominator}</td>}
          <td>{row.rate}</td>
          <td class="text">{dash(row.region)}</td>
          <td class="text">{row.status}</td>
          <td class="text"><a class="text-link" href={recordPath(row.recordId)}>Trace <Icon name="arrow-right" /></a></td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
