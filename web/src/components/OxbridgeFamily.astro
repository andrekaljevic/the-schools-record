---
/** One Oxford and Cambridge record family as a table, as the reference build laid it out. */
import Icon from './Icon.astro';
import Cell from './Cell.astro';
import type { OxbridgeRow } from '../lib/types';
import { recordPath } from '../lib/routes';
import { plural } from '../lib/html';
interface Props { family: string; label: string; summary: string; rows: OxbridgeRow[]; schoolScope: boolean }
const { family, label, summary, rows, schoolScope } = Astro.props;
const outcomeFamilies = new Set(['apply_centre_outcomes', 'derived_combined_oxbridge_apply_centre_outcomes', 'institution_overall_outcomes', 'subject_outcomes', 'subject_admissions_process']);
const subjectFamilies = new Set(['subject_outcomes', 'subject_admissions_process']);
const rounded = family === 'apply_centre_subject_outcomes_rounded' || family === 'apply_centre_college_outcomes_rounded';
const showCentre = !schoolScope && (family.startsWith('apply') || family.startsWith('derived'));
const dash = (value: unknown) => (value === null || value === undefined || value === '' ? '—' : String(value));
const sorted = [...rows];
if (outcomeFamilies.has(family)) sorted.sort((a, b) => (b.year ?? 0) - (a.year ?? 0) || String(a.institution).localeCompare(String(b.institution)) || String(a.subject ?? '').localeCompare(String(b.subject ?? '')) || String(a.applyCentre ?? '').localeCompare(String(b.applyCentre ?? '')));
else if (rounded) sorted.sort((a, b) => String(a.periodStart).localeCompare(String(b.periodStart)) || String(a.dimensionValue).localeCompare(String(b.dimensionValue)));
else if (family === 'school_published_oxbridge_offers') sorted.sort((a, b) => (b.year ?? 0) - (a.year ?? 0));
else if (family === 'historical_five_year_oxbridge_hit_rate') sorted.sort((a, b) => (a.rank ?? 0) - (b.rank ?? 0));
else if (family === 'course_competition') sorted.sort((a, b) => String(a.subject).localeCompare(String(b.subject)));
const note = family === 'historical_five_year_oxbridge_hit_rate'
  ? 'A 2007 secondary two-page excerpt. The five-year period is not stated and the methodology is unclear; the table is retained as it was published and is never mixed with the apply-centre records.'
  : family.startsWith('derived')
    ? 'Derived at source from exact, unsuppressed Oxford and Cambridge counts for the same named cycle; shown only where both universities use the same entry-cycle year.'
    : rounded
      ? 'Published as intervals rounded down to multiples of five. The record keeps the interval; no midpoint is invented.'
      : null;
---
<article class="ledger" id={`oxbridge-${family}`} data-family={family}>
  <header class="ledger-head"><div><p class="eyebrow">{summary}</p><h2>{label} · <span data-family-count>{rows.length}</span> {plural(rows.length, 'record')}</h2></div></header>
  {note && <p class="dataset-note">{note}</p>}
  <div class="table-scroll" tabindex="0" aria-label={`Scrollable table: ${label}`}>
    <table class="data-table corpus-table">
      <caption>{label}</caption>
      <thead>
        {outcomeFamilies.has(family) ? (
          <tr><th scope="col">Cycle</th><th scope="col">University</th>{subjectFamilies.has(family) && <th scope="col">Subject</th>}{showCentre && <th scope="col">Apply centre</th>}<th scope="col">Applications</th><th scope="col">Offers</th><th scope="col">Accepted / admitted</th><th scope="col">Offer rate</th><th scope="col">Accepted rate</th><th scope="col">Confidence</th><th scope="col">Source authority</th><th scope="col">Record</th></tr>
        ) : rounded ? (
          <tr><th scope="col">Period</th><th scope="col">University</th><th scope="col">Breakdown</th><th scope="col">Applications</th><th scope="col">Shortlisted</th><th scope="col">Offer holders</th><th scope="col">Note</th><th scope="col">Record</th></tr>
        ) : family === 'school_published_oxbridge_offers' ? (
          <tr><th scope="col">Cycle</th><th scope="col">Oxford offers</th><th scope="col">Cambridge offers</th><th scope="col">Total</th><th scope="col">Cohort scope</th><th scope="col">Note</th><th scope="col">Record</th></tr>
        ) : family === 'historical_five_year_oxbridge_hit_rate' ? (
          <tr><th scope="col">Rank</th><th scope="col">School as printed</th><th scope="col">Five-year admissions</th><th scope="col">Five-year hit rate</th><th scope="col">Published</th><th scope="col">Record</th></tr>
        ) : family === 'course_competition' ? (
          <tr><th scope="col">Period</th><th scope="col">University</th><th scope="col">Subject</th><th scope="col">Applicants per place</th><th scope="col">Note</th><th scope="col">Record</th></tr>
        ) : (
          <tr><th scope="col">Record</th><th scope="col">Cycle</th><th scope="col">University</th></tr>
        )}
      </thead>
      <tbody>
        {sorted.map((row) => (
          <tr data-university={row.institution ?? ''} data-year={row.year ?? ''} data-family={family}>
            {outcomeFamilies.has(family) ? (
              <>
                <th scope="row">{dash(row.year)}</th><td class="text">{dash(row.institution)}</td>{subjectFamilies.has(family) && <td class="text">{dash(row.subject)}</td>}{showCentre && <td class="text">{dash(row.applyCentre)}</td>}
                <Cell value={row.applications} /><Cell value={row.offers} /><Cell value={row.accepted} /><td>{row.offerRate}</td><td>{row.acceptedRate}</td><td class="text">{row.confidence}</td><td class="text">{row.authority}</td>
              </>
            ) : rounded ? (
              <><th scope="row">{dash(row.periodStart)}–{dash(row.periodEnd)}</th><td class="text">{dash(row.institution)}</td><td class="text">{dash(row.dimensionValue)}</td><Cell value={row.applications} /><Cell value={row.shortlisted} /><Cell value={row.offerHolders} /><td class="cell-note">{dash(row.note)}</td></>
            ) : family === 'school_published_oxbridge_offers' ? (
              <><th scope="row">{dash(row.year)}</th><Cell value={row.oxfordOffers} /><Cell value={row.cambridgeOffers} /><Cell value={row.totalOffers} /><td class="cell-note">{dash(row.cohortScope)}</td><td class="cell-note">{dash(row.note)}</td></>
            ) : family === 'historical_five_year_oxbridge_hit_rate' ? (
              <><th scope="row">{dash(row.rank)}</th><td class="text">{dash(row.schoolName)}</td><Cell value={row.fiveYearAdmissions} /><td>{row.fiveYearHitRate}</td><td>{dash(row.publicationDate)}</td></>
            ) : family === 'course_competition' ? (
              <><th scope="row">{dash(row.periodStart)}–{dash(row.periodEnd)}</th><td class="text">{dash(row.institution)}</td><td class="text">{dash(row.subject)}</td><td>{dash(row.applicantsPerPlace)}</td><td class="cell-note">{dash(row.note)}</td></>
            ) : (
              <><th scope="row">{row.recordId}</th><td>{dash(row.year)}</td><td class="text">{dash(row.institution)}</td></>
            )}
            <td class="text"><a class="text-link" href={recordPath(row.recordId)}>Trace <Icon name="arrow-right" /></a></td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</article>
