---
import Icon from './Icon.astro';
import type { SourceRef } from '../lib/types';
interface Props { sources: SourceRef[] }
const { sources } = Astro.props;
---
{sources.length === 0 ? (
  <p class="source-none">No public reference recorded.</p>
) : (
  <ul class="source-list">
    {sources.map((source) => (
      <li>
        <code class="source-key">{source.ref}</code>
        {source.url ? (
          <a class="source-link" href={source.url} target="_blank" rel="noreferrer noopener">{source.title} <Icon name="arrow-right" /></a>
        ) : source.withheld ? (
          <span class="source-withheld">{source.title}</span>
        ) : (
          <span>{source.title}</span>
        )}
        {source.role && <span class="source-role">{source.role}</span>}
      </li>
    ))}
  </ul>
)}
